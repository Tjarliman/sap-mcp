# Copy this file to .env and fill in YOUR OWN values.
#   copy .env.example .env   (Windows)   |   cp .env.example .env   (macOS/Linux)
#
# Per profile: HOST, CLIENT, USER, PASS. server.js contains none of these, so
# real hostnames never end up in the repo. Get the real HOST/CLIENT for each
# system from your team; use your own named SAP user for USER/PASS.
# Never commit .env - it is gitignored on purpose.
#
# FRIENDLY NAMES
#   Add  SAP_<KEY>_LABEL="Production"  to control how a profile is described by
#   list_servers. Without it the profile shows its bare key.
#
# WRITE PROTECTION
#   Add  SAP_<KEY>_READONLY=true   (or SAP_<KEY>_PROD=true) to block ALL writes
#   on that profile - creates, edits and activations are refused, reads still
#   work. Do this for every production system you add. Accepted values:
#   true / 1 / yes / y / X.
#
#   ABLP and ABLQ are ALSO blocked by a built-in list in server.js, so they
#   stay protected even if the flag below is missing. The two sources are
#   additive: a missing flag can never unblock a system.
#   Run list_servers to confirm - protected profiles show [read-only].

# ABLD - Development
SAP_ABLD_HOST="https://sap-dev.example.com:44300"
SAP_ABLD_CLIENT="100"
SAP_ABLD_USER=""
SAP_ABLD_PASS=""

# dev120 - Development, client 120
SAP_DEV120_HOST="https://sap-dev.example.com:44300"
SAP_DEV120_CLIENT="120"
SAP_DEV120_USER=""
SAP_DEV120_PASS=""

# snet - QA/Test
SAP_SNET_HOST="https://sap-qa.example.com:44300"
SAP_SNET_CLIENT="100"
SAP_SNET_USER=""
SAP_SNET_PASS=""

# ABLP - Production. Writes blocked; reads allowed.
SAP_ABLP_HOST="https://sap-prd.example.com:44300"
SAP_ABLP_CLIENT="500"
SAP_ABLP_USER=""
SAP_ABLP_PASS=""
SAP_ABLP_READONLY=true

# Example of adding ANOTHER production system - copy this block, rename the key,
# and keep the READONLY flag so it can never be written to.
# SAP_PRD2_HOST="https://sap-prd2.example.com:44300"
# SAP_PRD2_CLIENT="100"
# SAP_PRD2_USER=""
# SAP_PRD2_PASS=""
# SAP_PRD2_LABEL="Production - second system"
# SAP_PRD2_READONLY=true
#
# NOTE: the flag protects a PROFILE, not a system. If two profiles point at the
# same host AND client, flag both - otherwise writes still get through via the
# unflagged one.

# snet2 - S/4HANA on-prem
SAP_SNET2_HOST="http://sap-onprem.example.com:8000"
SAP_SNET2_CLIENT="100"
SAP_SNET2_USER=""
SAP_SNET2_PASS=""
